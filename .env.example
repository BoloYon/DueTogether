# Optional default Canvas address for Calendar settings. Leave it empty or set
# it to a verified school HTTPS origin, e.g. https://canvas.example.edu.
# This value is NOT secret: EXPO_PUBLIC_ variables are bundled into the app.
# NEVER put a Canvas token, password or any other secret in this file, in .env
# or in any EXPO_PUBLIC_ variable. Tokens are entered in the app and stored
# only in the phone's SecureStore. See docs/CANVAS_CONNECT.md.
EXPO_PUBLIC_CANVAS_BASE_URL=
